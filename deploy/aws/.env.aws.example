# ==============================================================================
# Argon Learning Backend — AWS Staging / Trial Environment Template
# Copy to `deploy/aws/.env.aws` on the AWS EC2 host (never commit `.env.aws`!)
# ==============================================================================

NODE_ENV=production
PORT=3000

# Public domain handled by Caddy for automatic Let's Encrypt HTTPS.
# - Real domain example: api.staging.yourdomain.com
# - Zero-domain EC2 IP example (replace dots with dashes): 13-212-45-67.sslip.io
API_DOMAIN=api-staging.your-domain-or-ip.sslip.io

# Exact Vercel URL(s) allowed to call this API (comma-separated, no trailing slash, never '*')
CORS_ORIGIN=https://your-argon-app.vercel.app

# Database connection:
# 1) For AWS RDS MySQL: set DB_HOST=<rds-endpoint>, DB_PORT=3306, DB_SSL=true
# 2) For local container MySQL (`--profile with-db`): set DB_HOST=mysql, DB_PORT=3306, DB_SSL=false
DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=argon_learning
DB_PASSWORD=replace_with_strong_db_password
DB_NAME=argon_learning
DB_SYNCHRONIZE=false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# Required ONLY if using `--profile with-db` (EC2 local MySQL container)
MYSQL_ROOT_PASSWORD=replace_with_strong_mysql_root_password

# JWT Authentication (generate with: openssl rand -hex 32)
JWT_SECRET=replace_with_at_least_64_random_hex_characters_for_access_tokens
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_a_different_64_random_hex_characters_for_refresh
JWT_REFRESH_EXPIRATION=7d

# Google OAuth (add your https://your-argon-app.vercel.app origin in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Groq AI (multi-model automatic failover; prefer high-TPM primary on AWS)
AI_PROVIDER=groq
GROQ_API_KEY=gsk_replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b

# Keep false in production; set true temporarily if testing API endpoints via /api/docs
ENABLE_SWAGGER=false
