# Application
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:4200

# MySQL Database
DB_HOST=127.0.0.1
DB_PORT=3311
DB_USERNAME=argon_learning
DB_PASSWORD=change_me_db_password
DB_NAME=argon_learning
DB_SYNCHRONIZE=false

# MySQL Docker container root password
MYSQL_ROOT_PASSWORD=change_me_root_password

# JWT Authentication (minimum 32 characters for JWT secrets)
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_a_different_strong_random_secret_at_least_32_chars
JWT_REFRESH_EXPIRATION=7d

# Google OAuth / OIDC (optional until Google Sign-In is configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Provider: 'none' (default) or 'groq' (free tier at https://console.groq.com/keys)
AI_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Swagger UI (auto-enabled outside production; set true only if explicitly needed)
ENABLE_SWAGGER=false
